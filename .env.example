# Copy to .env (same folder) and edit. .env is git-ignored; secrets stay on the server.

# ---- Ask SG-ERUP AI (optional) ---------------------------------------------
# Without a key, Ask AI runs in clearly labelled local fallback mode (excerpt search).
ANTHROPIC_API_KEY=
# auto | on | off  (on = use the SDK credential chain, e.g. after `ant auth login`)
SGERUP_LLM=auto
SGERUP_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
SGERUP_LLM_EFFORT=low
SGERUP_LLM_MAX_TOKENS=16000

# ---- Inference ---------------------------------------------------------------
# auto | cpu | cuda | cuda:0   (use cpu while a training job owns a small GPU)
SGERUP_DEVICE=auto
SGERUP_DETECTOR_WEIGHTS=weights/yolov3u.pt
SGERUP_IMGSZ=448
SGERUP_PRELOAD_DETECTOR=true

# ---- API ----------------------------------------------------------------------
SGERUP_MAX_UPLOAD_MB=15
# number of recent results kept in memory for download
SGERUP_RESULT_CACHE=40
SGERUP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SGERUP_ALLOW_TRAINING_JOBS=true

# ---- Frontend (set in the shell before `npm run dev`, or in frontend/.env) ----
# VITE_API_BASE=                              (empty = use the Vite proxy /api -> 127.0.0.1:8000)
# SGERUP_API_TARGET=http://127.0.0.1:8000     (proxy target used by `npm run dev`)
